{
    "name": "dwmc-api",
    "version": "0.1.0",
    "description": "Personal budget app backend API",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "prepare": "husky || true",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:integration": "tsx scripts/test-integration.ts",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset",
        "db:seed": "tsx prisma/seed.ts",
        "commitlint": "commitlint --edit"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.6",
        "@prisma/client": "^5.22.0",
        "@supabase/supabase-js": "^2.118.0",
        "dotenv": "^18.0.9",
        "hono": "^4.13.16",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "prettier": "^3.9.10",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "@prisma/client@5.22.0": true,
        "@prisma/engines@5.22.0": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "prisma@5.22.0": true
    }
}
