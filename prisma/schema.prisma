generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// UserProfile is the central identity record that links a Supabase Auth user
// (identified by authUserId) to all business data in the application.
// All future tables (transactions, accounts, budgets, etc.) must reference
// UserProfile.id to ensure data is always scoped to a single user.
model UserProfile {
  id         String   @id @default(cuid())
  authUserId String   @unique
  email      String?
  firstName  String?
  lastName   String?
  displayName String?
  preferredCurrency String   @default("CAD")
  locale     String   @default("fr-CA")
  sections   Section[]
  categories Category[]
  accounts   Account[]
  transactions Transaction[]
  budgets     Budget[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Section {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  name          String
  color         String
  isArchived    Boolean     @default(false)
  categories    Category[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userProfileId])
  @@unique([userProfileId, name])
}

model Category {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name          String
  icon          String
  isArchived    Boolean     @default(false)
  transactions   Transaction[]
  budgets        Budget[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userProfileId])
  @@index([sectionId])
  @@unique([userProfileId, sectionId, name])
}

model Account {
  id              String      @id @default(cuid())
  userProfileId   String
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  name            String
  type            AccountType @default(CHECKING)

  startingBalance Decimal     @default(0) @db.Decimal(12, 2)
  goal            Decimal?    @db.Decimal(12, 2)

  transactions     Transaction[] @relation("AccountTransactions")
  transfersOut     Transaction[] @relation("TransferFromAccount")
  transfersIn      Transaction[] @relation("TransferToAccount")

  color           String
  icon            String

  isArchived      Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userProfileId])
  @@unique([userProfileId, name])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

model Transaction {
  id            String          @id @default(cuid())
  userProfileId String
  userProfile   UserProfile    @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  accountId     String?
  account       Account?       @relation("AccountTransactions", fields: [accountId], references: [id])

  fromAccountId String?
  fromAccount   Account?       @relation("TransferFromAccount", fields: [fromAccountId], references: [id])

  toAccountId   String?
  toAccount     Account?       @relation("TransferToAccount", fields: [toAccountId], references: [id])

  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])

  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime
  merchant      String?
  note          String?

  isArchived    Boolean         @default(false)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userProfileId])
  @@index([accountId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
}

model Budget {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  month         String
  amount        Decimal     @db.Decimal(12, 2)

  isArchived    Boolean     @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userProfileId])
  @@index([categoryId])
  @@index([month])
  @@unique([userProfileId, categoryId, month])
}
