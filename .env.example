NODE_ENV="development"
PORT=3000

# The single browser origin allowed by the local frontend.
APP_ORIGIN="http://localhost:5182"

# Prisma connects to local PostgreSQL. Docker Compose uses postgres/postgres and
# creates the dwmc_api database on localhost:5432.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# Backend Supabase variables. The anon key is publishable, but keep all local
# environment configuration out of version control.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
