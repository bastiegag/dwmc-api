NODE_ENV="development"
PORT=3000

APP_ORIGIN="http://localhost:5182"

# Replace <user>, <password>, <host>, <port> and <dbname> with your local values.
# For Docker Compose defaults: user=postgres ****** host=localhost port=5432 dbname=dwmc_api
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# Backend Supabase variables — never expose these to the frontend.
# SUPABASE_ANON_KEY is required by the environment schema but is not used for
# server-side token validation; the backend auth client uses the service-role key.
# SUPABASE_SERVICE_ROLE_KEY is a secret admin key that bypasses Row Level Security.
#   - Never share it with the browser or commit it to version control.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
