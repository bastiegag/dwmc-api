NODE_ENV="development"
PORT=3000

# The single browser origin allowed by the API. Set this to the Vercel
# production URL in Render; keep localhost here for local development.
APP_ORIGIN="http://localhost:5182"

# Replace the placeholders with a local PostgreSQL URL for development. Render
# should receive the selected Supabase PostgreSQL URL as DATABASE_URL.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# Backend Supabase variables. The anon key is publishable, but keep all local
# environment configuration out of version control.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
